{
  "name": "scamshield",
  "version": "2.0.0",
  "description": "Open-source OSINT & scam-intelligence engine: investigate emails, domains, URLs, IPs and phone numbers across live public data sources.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/copy-assets.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx server/seed-cli.ts",
    "data:disposable": "node scripts/update-disposable.mjs",
    "lint:design": "node scripts/lint-design.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.5",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.18",
    "lucide-react": "^0.453.0",
    "openai": "^5.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts": "^7.4.15",
    "wouter": "^3.3.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.8"
  }
}
