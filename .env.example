# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# SQLite file. In production point this at a persistent disk, e.g. /var/data/scamshield.db
DATABASE_URL=sqlite.db
# Reverse proxies in front of the app (Render/Fly/Heroku/nginx = 1). Needed for per-IP rate limits.
TRUST_PROXY=1
LOG_LEVEL=info
# Long random string — used to hash reporter IPs for report de-duplication.
REPORTER_SALT=change-me-to-a-long-random-string

# ── Deployment ───────────────────────────────────────────────────────
# Public origin used for absolute og:url / og:image, e.g. https://scamshield.example
# Required in production. On Render it falls back to RENDER_EXTERNAL_URL automatically.
SITE_URL=
# Set to true only when DATABASE_URL is on persistent storage (a disk or volume that survives
# restarts). Leave empty on ephemeral hosts (e.g. Render Free): the UI then tells users that
# reports are stored temporarily and cleared when the server restarts.
STORAGE_PERSISTENT=

# ── Behaviour ────────────────────────────────────────────────────────
# Region used to interpret phone numbers without a +country prefix (ISO 3166 alpha-2).
DEFAULT_PHONE_REGION=US
LOOKUP_CACHE_TTL_MINUTES=360
CHECK_TIMEOUT_MS=8000
RATE_LIMIT_LOOKUPS_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_HOUR=10
# Optional comma-separated resolvers. Note: Spamhaus/URIBL refuse queries from big public
# resolvers (8.8.8.8, 1.1.1.1) — use your host's resolver or a local unbound for DNSBLs.
DNS_SERVERS=

# ── Optional integrations (each source is skipped when its key is empty) ──
# Plain-language AI summaries (the risk score itself is always deterministic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# Free at https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# Raises GitHub search limits from 10 to 30 req/min (no scopes needed)
GITHUB_TOKEN=
# https://gravatar.com/developers — raises rate limits
GRAVATAR_API_KEY=
